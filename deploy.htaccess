Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Served from dist/ as https://qla.dev/helem-nejse, so match files relative
  # to this directory, not DOCUMENT_ROOT.
  # Real files and folders (assets/, img/, maps/, og-cover.jpg) load as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Every other path (/igra/kart, /igra/tram, ...) opens the React app.
  RewriteRule ^ index.html [L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
